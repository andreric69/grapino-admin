# Serverseitig genutzt (Vercel-Funktionen in /api) - NIEMALS mit VITE_-Praefix,
# sonst landen die Werte im Browser-Bundle.

# Frei gewaehltes Admin-Passwort fuer den Login der Admin-App.
ADMIN_PASSWORD=

# Geheimer Schluessel zum Signieren der Login-Session (beliebiger langer
# Zufallstext, z.B. per `openssl rand -hex 32` erzeugt).
SESSION_SECRET=

# Dieselbe Supabase-Projekt-URL wie in der Haupt-Weinapp.
SUPABASE_URL=

# ACHTUNG: das ist der Admin-Schluessel mit vollem Datenbankzugriff (umgeht
# Row-Level-Security). Nur hier, nur serverseitig, NIE im Frontend-Code.
SUPABASE_SERVICE_ROLE_KEY=

# Fuer den E-Mail-Versand (Vorlagen/Tutorials) - API-Key von resend.com
# (kostenloses Konto, Free-Tier reicht fuer diesen Anwendungsfall).
RESEND_API_KEY=

# Absenderadresse - ohne eigene verifizierte Domain bei Resend nur
# "Grapino <onboarding@resend.dev>" moeglich, kann dann aber NUR an die
# E-Mail-Adresse schicken, mit der das Resend-Konto selbst registriert ist.
# Fuer echten Versand an Gregor/Thomas wird eine verifizierte Domain (Resend
# -> Domains) benoetigt.
RESEND_FROM_ADDRESS=
